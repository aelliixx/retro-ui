{
  "name": "@retro-ui/ui",
  "version": "0.5.0",
  "description": "React + Tailwind components styled after 90s desktop UIs — carved group boxes, sunken input wells and hatched title bars, rebuilt with modern tokens.",
  "license": "MIT",
  "author": "aelliixx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aelliixx/retro-ui.git"
  },
  "bugs": {
    "url": "https://github.com/aelliixx/retro-ui/issues"
  },
  "homepage": "https://github.com/aelliixx/retro-ui#readme",
  "sideEffects": ["**/*.css"],
  "type": "module",
  "files": ["dist", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles/styles.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./utilities.css": "./src/styles/utilities.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "node scripts/prepack.mjs",
    "postpack": "node scripts/postpack.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "keywords": [
    "react",
    "tailwind",
    "retro",
    "90s",
    "design-system",
    "components",
    "nostalgia",
    "bevel",
    "windows-95"
  ]
}
