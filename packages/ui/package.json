{
  "name": "@retro-ui/ui",
  "version": "0.5.0",
  "description": "React + Tailwind components styled after 90s desktop UIs \u2014 carved group boxes, sunken input wells and hatched title bars, rebuilt with modern tokens.",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles/styles.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./utilities.css": "./src/styles/utilities.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css",
      "./tokens.css": "./dist/tokens.css",
      "./utilities.css": "./dist/utilities.css",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "keywords": [
    "react",
    "tailwind",
    "retro",
    "90s",
    "design-system",
    "components",
    "nostalgia"
  ]
}
