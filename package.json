{
  "name": "retro-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root \u2014 the retro/ui component library and its documentation site.",
  "license": "MIT",
  "author": "aelliixx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aelliixx/retro-ui.git"
  },
  "bugs": {
    "url": "https://github.com/aelliixx/retro-ui/issues"
  },
  "homepage": "https://github.com/aelliixx/retro-ui#readme",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @retro-ui/docs",
    "build": "npm run build --workspace @retro-ui/docs",
    "start": "npm run start --workspace @retro-ui/docs",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.include='packages/*/src/**' --coverage.include='apps/*/src/**' --coverage.reporter=text",
    "typecheck": "tsc --noEmit",
    "build:ui": "npm run build --workspace @retro-ui/ui",
    "test:visual": "npm run test:visual --workspace @retro-ui/docs --"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "happy-dom": "^21.0.3",
    "jsdom": "^30.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
